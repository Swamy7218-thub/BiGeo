# Claude API — extraction and reasoning over bills/rate contracts.
# Default: direct Anthropic API. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Alternative: route the same calls through Amazon Bedrock (e.g. to spend
# AWS credits instead of an Anthropic bill). Set CLAUDE_PROVIDER=bedrock and
# leave ANTHROPIC_API_KEY blank — AWS credentials come from the standard AWS
# credential provider chain (env vars below, or ~/.aws/credentials, or an
# instance/task role if deployed on AWS).
# CLAUDE_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=   # exact model or inference-profile ID from the Bedrock console

# Supabase project (Postgres + Storage). Create a project at https://supabase.com,
# run supabase/migrations/0001_init.sql against it, and create a private
# Storage bucket named "documents".
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
