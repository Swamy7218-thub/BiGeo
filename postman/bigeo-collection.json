            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Logistics Co.\",\n  \"email\": \"demo@example.com\",\n  \"phone\": \"+91-9876543210\",\n  \"company\": \"Demo Logistics\",\n  \"use_case\": \"last-mile delivery\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "Register a new API user. Returns an API key for subsequent requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 201', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const json = pm.response.json();",
